                  <family>Segoe UI</family>
                  <pointsize>12</pointsize>
                  <bold>true</bold>
                 </font>
                </property>
                <property name="styleSheet">
                 <string notr="true">color: #3498db;</string>
                </property>
                <property name="text">
                 <string>Глава 4. Детекция объектов</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QScrollArea" name="scrollArea_18">
                <property name="styleSheet">
                 <string notr="true">QScrollArea {
    border: none;
}</string>
                </property>
                <property name="widgetResizable">
                 <bool>true</bool>
                </property>
                <widget class="QWidget" name="scrollAreaWidgetContents_18">
                 <property name="geometry">
                  <rect>
                   <x>0</x>
                   <y>0</y>
                   <width>167</width>
                   <height>2096</height>
                  </rect>
                 </property>
                 <layout class="QVBoxLayout" name="verticalLayout_46">
                  <property name="spacing">
                   <number>16</number>
                  </property>
                  <property name="leftMargin">
                   <number>0</number>
                  </property>
                  <property name="topMargin">
                   <number>0</number>
                  </property>
                  <property name="rightMargin">
                   <number>0</number>
                  </property>
                  <property name="bottomMargin">
                   <number>0</number>
                  </property>
                  <item>
                   <widget class="QLabel" name="theoryTitle_10">
                    <property name="font">
                     <font>
                      <family>Segoe UI</family>
                      <pointsize>14</pointsize>
                      <bold>true</bold>
                     </font>
                    </property>
                    <property name="styleSheet">
                     <string notr="true">color: #2980b9;</string>
                    </property>
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif';&quot;&gt;4.1. Каскады Хаара&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QLabel" name="theoryContent_10">
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:115%;&quot;&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; text-decoration: underline;&quot;&gt;Как работают Haar-признаки?&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Каскад Хаара &lt;span style=&quot; color:#404040;&quot;&gt;–&lt;/span&gt; это классический подход к детекции объектов, разработанный Полом Виолой и Майклом Джонсом в 2001 году. Метод основан на обнаружении характерных паттернов (признаков) на изображении, которые называются &lt;span style=&quot; font-weight:700;&quot;&gt;Haar-признаками&lt;/span&gt;. Haar-признак &lt;span style=&quot; color:#404040;&quot;&gt;–&lt;/span&gt; это разница в интенсивности между областями изображения, задаваемыми простыми прямоугольниками. &lt;/p&gt;&lt;p&gt;Основные шаги каскадов Хаара: &lt;/p&gt;&lt;p&gt;1.&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Создание интегрального изображения&lt;/span&gt;: Для ускорения вычислений создается специальная структура данных &lt;span style=&quot; color:#404040;&quot;&gt;–&lt;/span&gt; интегральное изображение, позволяющее быстро вычислять сумму пикселей в любой прямоугольной области. &lt;/p&gt;&lt;p&gt;2.&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Определение признаков&lt;/span&gt;: Изображение разбивается на множество прямоугольников разного размера и ориентации. Затем проверяется различие средних значений пикселей между этими прямоугольниками. Типичными признаками являются комбинации двух, трех или четырех прямоугольников. &lt;/p&gt;&lt;p&gt;3.&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Классификация признаков&lt;/span&gt;: Каждому признаку присваивается определенное значение (вес), которое определяет значимость этого признака для идентификации объекта. Признаки с наибольшим весом считаются самыми информативными. &lt;/p&gt;&lt;p&gt;4.&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Каскадная структура&lt;/span&gt;: Все признаки сортируются по важности, и менее эффективные признаки исключаются на ранних этапах. Каскад организует проверку признаков последовательно: если признак на одном этапе не проходит, дальнейшее рассмотрение прекращается, ускоряя процесс детекции. &lt;/p&gt;&lt;p&gt;5.&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Тренировочный этап&lt;/span&gt;: На стадии обучения собирается большое количество положительных примеров (лиц, автомобилей и др.) и отрицательных примеров (фон, другие объекты). Алгоритм AdaBoost выбирает лучшие признаки и создает эффективный классификатор. &lt;/p&gt;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:115%;&quot;&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; text-decoration: underline;&quot;&gt;Детекция лиц и объектов.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Классический пример применения каскадов Хаара &lt;span style=&quot; color:#404040;&quot;&gt;–&lt;/span&gt; это &lt;span style=&quot; font-weight:700;&quot;&gt;детектор лиц&lt;/span&gt;, встроенный в большинство современных камер смартфонов и фотоаппаратов. Лицо рассматривается как набор определенных примитивов (глаза, рот, брови), и характерные различия между ними позволяют эффективно определять лицо на любом изображении. &lt;/p&gt;&lt;p&gt;Каскады Хаара особенно эффективны для детекции лиц благодаря следующим особенностям: &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Высокая скорость:&lt;/span&gt; Благодаря использованию интегральных изображений и каскадной структуры, метод обеспечивает быструю обработку изображений в реальном времени. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Устойчивость к вариациям:&lt;/span&gt; Способен обнаруживать лица под разными углами, с разнообразными выражениями и в условиях изменчивого освещения. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Простота реализации:&lt;/span&gt; Легко реализуется с помощью библиотеки OpenCV (cv2.CascadeClassifier). &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                    <property name="wordWrap">
                     <bool>true</bool>
                    </property>
                   </widget>
                  </item>
