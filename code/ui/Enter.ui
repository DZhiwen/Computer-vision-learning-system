              </item>
              <item>
               <widget class="QScrollArea" name="scrollArea_16">
                <property name="styleSheet">
                 <string notr="true">QScrollArea {
    border: none;
}</string>
                </property>
                <property name="widgetResizable">
                 <bool>true</bool>
