               </widget>
              </item>
              <item>
               <widget class="QScrollArea" name="scrollArea_21">
                <property name="widgetResizable">
                 <bool>true</bool>
                </property>
                <widget class="QWidget" name="scrollAreaWidgetContents_21">
                 <property name="geometry">
                  <rect>
                   <x>0</x>
                   <y>0</y>
                   <width>529</width>
                   <height>560</height>
                  </rect>
                 </property>
                 <layout class="QVBoxLayout" name="verticalLayout_53">
                  <item>
                   <widget class="QLabel" name="label_15">
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:large; font-weight:700; color:#000000;&quot;&gt;Пример использования YOLO в OpenCV:&lt;/span&gt;&lt;/h3&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;net = cv2.dnn.readNet('yolov3.weights', 'yolov3.cfg')&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;blob = cv2.dnn.blobFromImage(image, scalefactor=1/255, size=(416, 416))&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;net.setInput(blob)&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;output_layers = net.getUnconnectedOutLayersNames()&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;detections = net.forward(output_layers)&lt;/span&gt;&lt;/pre&gt;&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:large; font-weight:700; color:#000000;&quot;&gt;Пример использования SSD в TensorFlow:&lt;/span&gt;&lt;/h3&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;model = tf.saved_model.load('ssd_mobilenet_v2/saved_model')&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;detect_fn = model.signatures['serving_default']&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New'; color:#000000;&quot;&gt;detections = detect_fn(tf.convert_to_tensor(image))&lt;/span&gt;&lt;/pre&gt;&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:large; font-weight:700; color:#000000;&quot;&gt;Преимущества предобученных моделей:&lt;/span&gt;&lt;/h3&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt; color:#000000;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt; color:#000000;&quot;/&gt;&lt;span style=&quot; color:#000000;&quot;&gt;Экономия времени на обучении.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt; color:#000000;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt; color:#000000;&quot;/&gt;&lt;span style=&quot; color:#000000;&quot;&gt;Высокая точность на стандартных задачах (COCO, Pascal VOC).&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt; color:#000000;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt; color:#000000;&quot;/&gt;&lt;span style=&quot; color:#000000;&quot;&gt;Поддержка GPU для ускорения.&lt;/span&gt;&lt;/p&gt;&lt;h3 style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:large; font-weight:700; color:#000000;&quot;&gt;Настройка под свои задачи:&lt;/span&gt;&lt;/h3&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt; color:#000000;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt; color:#000000;&quot;/&gt;&lt;span style=&quot; color:#000000;&quot;&gt;Дообучение (fine-tuning) на своих данных.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;Изменение анкерных рамок для специфичных объектов. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Symbol'; font-size:10pt;&quot;&gt;·&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;Оптимизация под конкретное оборудование (мобильные устройства, серверы). &lt;/p&gt;&lt;p&gt;Таким образом, современные методы, такие как YOLO и SSD, решают основную проблему предыдущего поколения алгоритмов, обеспечивая высокую точность и скорость детекции объектов в режиме реального времени. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                    <property name="wordWrap">
                     <bool>true</bool>
                    </property>
                   </widget>
                  </item>
                 </layout>
                </widget>
               </widget>
