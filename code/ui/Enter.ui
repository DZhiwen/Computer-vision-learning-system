                  <pointsize>12</pointsize>
                  <bold>true</bold>
                 </font>
                </property>
                <property name="styleSheet">
                 <string notr="true">color: #3498db;</string>
                </property>
                <property name="text">
                 <string>Глава 3. Границы и признаки</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QScrollArea" name="scrollArea_12">
                <property name="styleSheet">
                 <string notr="true">QScrollArea {
    border: none;
}</string>
                </property>
                <property name="widgetResizable">
                 <bool>true</bool>
                </property>
                <widget class="QWidget" name="scrollAreaWidgetContents_12">
                 <property name="geometry">
                  <rect>
                   <x>0</x>
                   <y>0</y>
                   <width>381</width>
                   <height>1528</height>
                  </rect>
                 </property>
                 <layout class="QVBoxLayout" name="verticalLayout_33">
                  <property name="spacing">
                   <number>16</number>
                  </property>
                  <property name="leftMargin">
                   <number>0</number>
                  </property>
                  <property name="topMargin">
                   <number>0</number>
                  </property>
                  <property name="rightMargin">
                   <number>0</number>
                  </property>
                  <property name="bottomMargin">
                   <number>0</number>
                  </property>
                  <item>
                   <widget class="QLabel" name="theoryTitle_8">
                    <property name="font">
                     <font>
                      <family>Segoe UI</family>
                      <pointsize>14</pointsize>
                      <bold>true</bold>
                     </font>
                    </property>
                    <property name="styleSheet">
                     <string notr="true">color: #2980b9;</string>
                    </property>
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif';&quot;&gt;3.1. Детекция границ (Canny, Sobel)&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                   </widget>
                  </item>
                  <item>
                   <widget class="QLabel" name="theoryContent_8">
                    <property name="text">
                     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;Детекция границ &lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;–&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt; это ключевая задача в компьютерном зрении, направленная на выделение контуров объектов на изображении. Границы представляют собой области, где происходит резкое изменение интенсивности пикселей, что позволяет идентифицировать форму и структуру объектов. В этом разделе рассматриваются два основных подхода: операторы градиента (Sobel) и метод Кэнни.&lt;/span&gt;&lt;/p&gt;&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; margin-top:0px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:115%;&quot;&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;Операторы градиента.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; font-weight:700; color:#404040;&quot;&gt;Градиент изображения&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt; – это вектор, показывающий направление и скорость изменения интенсивности пикселей. Операторы градиента вычисляют приближенные значения производных изображения по горизонтали и вертикали, что позволяет находить границы. Наиболее распространенными операторами являются &lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; font-weight:700; color:#404040;&quot;&gt;Собела (Sobel)&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; font-weight:700; color:#404040;&quot;&gt;Превитта (Prewitt)&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt; и &lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; font-weight:700; color:#404040;&quot;&gt;Щарра (Scharr)&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; font-weight:700; color:#404040;&quot;&gt;Оператор Собела (Sobel):&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;&lt;br/&gt;Этот оператор использует свертку изображения с двумя ядрами (фильтрами) – для горизонтальных &lt;/span&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;24&quot; height=&quot;20&quot;/&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;) и вертикальных (&lt;/span&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;18&quot; height=&quot;22&quot;/&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;) производных.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;Градиент в каждой точке вычисляется как:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;237&quot; height=&quot;42&quot;/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;где &lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; font-style:italic; color:#404040;&quot;&gt;G&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt; – величина градиента, а &lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; font-style:italic; color:#404040;&quot;&gt;θ&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt; – его направление.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt; color:#404040;&quot;&gt;Пример реализации в OpenCV:&lt;/span&gt;&lt;/p&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;sobel_x = cv2.Sobel(image, cv2.CV_64F, 1, 0, ksize=3)&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;sobel_y = cv2.Sobel(image, cv2.CV_64F, 0, 1, ksize=3)&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;gradient_magnitude = np.sqrt(sobel_x**2 + sobel_y**2)&lt;/span&gt;&lt;/pre&gt;&lt;pre style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;span style=&quot; font-family:'Courier New';&quot;&gt;gradient_direction = np.arctan2(sobel_y, sobel_x)&lt;/span&gt;&lt;/pre&gt;&lt;p&gt;&lt;br/&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;Метод Кэнни считается золотым стандартом детекции границ, поскольку он объединяет ряд этапов, обеспечивающих устойчивое выделение контурных линий. Вот пошагово этапы метода Кэнни:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;1.     Шумоподавление: Перед обработкой выполняется предварительное размытие изображения с помощью гауссова фильтра. Это снижает чувствительность к шуму и обеспечивает более точную границу.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;2.     Вычисление градиента: Используются операторы типа Собела для нахождения направления и величины градиента в каждой точке изображения.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;3.     Нелинейная аппроксимация градиента: После вычисления градиента осуществляется нелинейная экстраполяция величин градиента вдоль краев, удаляя лишние ложные пикселы, оставшиеся после этапа 2.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;4.     Пороговая обработка: Используется двойная пороговая фильтрация для устранения малозначимых изменений яркости. Устанавливается верхний и нижний порог:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Wingdings'; font-size:12pt;&quot;&gt;ü&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;Пиксели с интенсивностью выше верхнего порога считаются достоверными краями.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Wingdings'; font-size:12pt;&quot;&gt;ü&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;Пиксели с интенсивностью ниже нижнего порога отбрасываются.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Wingdings'; font-size:12pt;&quot;&gt;ü&lt;/span&gt;&lt;span style=&quot; font-family:'Times New Roman'; font-size:7pt;&quot;/&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;Между верхним и нижним порогом проводится дополнительная проверка на непрерывность границы.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;5.     Трассировка кромок: Проверяются соседние пиксели, чтобы убедиться, что найденные границы действительно образуют замкнутые или продолжающиеся линии.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-family:'Times New Roman','serif'; font-size:12pt;&quot;&gt;Таким образом, метод Кэнни способен уверенно выделять настоящие границы объектов, игнорируя помехи и шум, присутствующие в изображении.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                    <property name="textFormat">
                     <enum>Qt::TextFormat::AutoText</enum>
                    </property>
                    <property name="wordWrap">
                     <bool>true</bool>
                    </property>
                   </widget>
                  </item>
