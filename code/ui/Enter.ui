            <widget class="QWidget" name="tab4_1_1">
             <attribute name="title">
              <string>Каскад Хаара</string>
             </attribute>
             <layout class="QVBoxLayout" name="verticalLayout_45">
              <property name="spacing">
               <number>12</number>
              </property>
              <property name="leftMargin">
